# --- PostgreSQL (PostGIS) ---
# Tortoise-ORM DSN format: postgres://user:password@host:port/database
POSTGRES_DSN=postgres://admin:supersecretpassword@localhost:5432/wildlife_db

# --- MongoDB ---
MONGO_URI=mongodb://admin:supersecretpassword@localhost:27017/?authSource=admin
MONGO_DB_NAME=wildlife_monitoring

# --- JWT ---
JWT_SECRET_KEY=super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
