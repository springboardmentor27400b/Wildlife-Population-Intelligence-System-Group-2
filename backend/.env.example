# --- PostgreSQL (PostGIS) ---
# Tortoise-ORM DSN format: postgres://user:password@host:port/database
POSTGRES_DSN=postgres://wildlife_user:wildlife_pass@localhost:5432/wildlife_db

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=wildlife_monitoring

# --- JWT ---
JWT_SECRET_KEY=super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
