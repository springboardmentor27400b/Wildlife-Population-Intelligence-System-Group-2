# MongoDB Connection (Do not commit real passwords)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wildlife_db?retryWrites=true&w=majority

# JWT Settings
JWT_SECRET=your_secure_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
APP_NAME=Wildlife Population Intelligence System API
API_V1_STR=/api/v1
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# CORS (Comma separated list of allowed origins)
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:80,https://yourdomain.com
