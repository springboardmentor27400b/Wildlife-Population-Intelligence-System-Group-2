# =====================================================
# WILDLIFE POPULATION INTELLIGENCE SYSTEM
# PRODUCTION & LOCAL ENVIRONMENT MATRIX
# =====================================================

# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Static Site)
# Production on Render: https://<your-backend-name>.onrender.com
# Local development: leave empty or http://localhost:8000
VITE_API_URL=https://wildlife-backend-vdvt.onrender.com

# 2. BACKEND SERVER CONFIGURATION (FastAPI Web Service)
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
PORT=10000
HOST=0.0.0.0

# 3. DATABASE CONFIGURATION
# SQLite (Local Development): sqlite:///./wildlife.db
# PostgreSQL (Render Managed DB / Production / Docker):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
POSTGRES_USER=your_database_user_here
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB=wildlife_prod

# 4. SECURITY & AUTHENTICATION
SECRET_KEY=generate_a_secure_random_64_character_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. CORS ORIGIN ACCESS CONTROL
# Comma-separated list of allowed origins
CORS_ORIGINS=https://wildlife-frontend-kjbn.onrender.com,https://wildlife-frontend.onrender.com,http://localhost:5173

# 6. EXTERNAL APIS & DATASETS
GBIF_API_URL=https://api.gbif.org/v1/species/match
DATASET_PATH=datasets
YOLO_MODEL_PATH=yolov8s.pt
