# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wildlife_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wildlife_db

# Security & JWT Configuration
SECRET_KEY=supersecretjwtkeyforwildlifepopulationintelligence2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Cloudinary Storage Configuration
# Fill these in to enable cloud storage, otherwise local storage fallback is used
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Local File Storage Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760 # 10MB in bytes
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,ogg,m4a
