# =====================================================
# WILDLIFE POPULATION INTELLIGENCE SYSTEM
# ENVIRONMENT CONFIGURATION MATRIX
# =====================================================

# 1. APPLICATION ENVIRONMENT
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# 2. BACKEND SERVER CONFIGURATION
PORT=8000
HOST=0.0.0.0
WORKERS=4

# 3. DATABASE CONFIGURATION
# Development (SQLite Fallback):
# DATABASE_URL=sqlite:///./wildlife.db
# Production (PostgreSQL Container / Managed RDS):
DATABASE_URL=postgresql://wildlife_admin:CHANGE_THIS_PRODUCTION_PASSWORD@db:5432/wildlife_prod

# 4. SECURITY & AUTHENTICATION
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. CORS ORIGIN ACCESS CONTROL
CORS_ORIGINS=https://wildlife.yourdomain.com,http://localhost:5173

# 6. EXTERNAL APIS & DATASETS
GBIF_API_URL=https://api.gbif.org/v1/species/match
DATASET_PATH=backend/dataset

# 7. PRODUCTION DOMAIN & TLS
DOMAIN_NAME=wildlife.yourdomain.com
SSL_CERT_PATH=/etc/nginx/ssl/live/wildlife.yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/live/wildlife.yourdomain.com/privkey.pem
