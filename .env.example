# =====================================================
# WILDLIFE POPULATION INTELLIGENCE SYSTEM
# ENVIRONMENT CONFIGURATION MATRIX
# =====================================================

# 1. APPLICATION ENVIRONMENT
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# 2. BACKEND SERVER CONFIGURATION
PORT=8000
HOST=0.0.0.0
WORKERS=4

# 3. DATABASE CONFIGURATION
# Development (SQLite Fallback):
# DATABASE_URL=sqlite:///./wildlife.db
# Production (Render PostgreSQL / Docker / Managed RDS):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 4. SECURITY & AUTHENTICATION
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. CORS ORIGIN ACCESS CONTROL
CORS_ORIGINS=https://wildlife-frontend.onrender.com,http://localhost:5173

# 6. EXTERNAL APIS & DATASETS
GBIF_API_URL=https://api.gbif.org/v1/species/match
DATASET_PATH=datasets
